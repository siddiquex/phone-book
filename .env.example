# Copy to .env at the repo root:  cp .env.example .env
# DATABASE_URL must match the POSTGRES_* values below.

POSTGRES_USER=phonebook
POSTGRES_PASSWORD=phonebook
POSTGRES_DB=phonebook
POSTGRES_PORT=5432

DATABASE_URL=postgres://phonebook:phonebook@localhost:5432/phonebook

NODE_ENV=development
PORT=5000
# Where apps/web proxies /api/* to (server-side rewrite — never reaches the browser)
API_URL=http://localhost:5000
