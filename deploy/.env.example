# Copy to .env alongside docker-compose.prod.yml, then fill in. Docker Compose reads a
# file named .env from the directory it runs in, which is why the password lives here and
# not in the committed compose file.

# The hostname Caddy serves and requests a certificate for. With no domain of your own,
# use the Elastic IP under nip.io, which resolves straight back to it:
#   203.0.113.5  ->  203.0.113.5.nip.io
# The IP must not change, which is what an Elastic IP is for.
SITE_ADDRESS=203.0.113.5.nip.io

# Change the password. The user and database name can stay as they are.
POSTGRES_USER=phonebook
POSTGRES_PASSWORD=change-me
POSTGRES_DB=phonebook

# Which published images to run: a branch (develop, main) or an exact sha-<short> for a
# build you can reproduce. `latest` only exists once main has been updated.
IMAGE_TAG=develop

# The GitHub account that owns the packages.
GHCR_OWNER=siddiquex

# Caddy terminates TLS in front of the stack, so the cookie is genuinely Secure.
COOKIE_SECURE=true
