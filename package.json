{
  "name": "phone-book",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm build:shared && pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "build:shared": "pnpm -r --filter \"./shared/*\" build",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "test:e2e": "pnpm -r test:e2e",
    "typecheck": "pnpm -r typecheck",
    "db:generate": "pnpm --filter @phone-book/db generate",
    "db:migrate": "pnpm --filter @phone-book/db migrate",
    "db:push": "pnpm --filter @phone-book/db push",
    "db:studio": "pnpm --filter @phone-book/db studio"
  }
}
